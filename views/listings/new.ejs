<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Listing</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow p-4">
        <h3 class="text-center mb-4">Create New Listing</h3>

        <form action="/listings" method="POST">

          <input name="listing[title]" class="form-control mb-3" placeholder="Enter title">

          <textarea name="listing[description]" class="form-control mb-3" placeholder="Enter description"></textarea>

          <input name="listing[image][url]" class="form-control mb-3" placeholder="Enter image URL">

          <input name="listing[price]" class="form-control mb-3" placeholder="Enter price">

          <input name="listing[location]" class="form-control mb-3" placeholder="Enter location">

          <input name="listing[country]" class="form-control mb-3" placeholder="Enter country">

          <div class="d-grid gap-2">
            <button class="btn btn-success">Add Listing</button>
            <a href="/listings" class="btn btn-dark">Back</a>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>

</body>
</html>