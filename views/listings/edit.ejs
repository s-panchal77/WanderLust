<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Listing</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow p-4">
        <h3 class="text-center mb-4">Edit Listing</h3>

        <form action="/listings/<%= listing._id %>" method="POST">
        
          <input type="hidden" name="_method" value="PUT">
        
          <input name="listing[title]" class="form-control mb-3" value="<%= listing.title %>">
        
          <textarea name="listing[description]" class="form-control mb-3"><%= listing.description %></textarea>
        
          <input name="listing[image][url]" class="form-control mb-3" value="<%= listing.image.url %>">
        
          <input name="listing[price]" class="form-control mb-3" value="<%= listing.price %>">
        
          <input name="listing[location]" class="form-control mb-3" value="<%= listing.location %>">
        
          <input name="listing[country]" class="form-control mb-3" value="<%= listing.country %>">
        
          
            <div class="d-flex justify-content-between">
                <a href="/listings/<%= listing._id %>" class="btn btn-secondary">Back</a>
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">Update Listing</a>
            </div>
        </form>

      </div>

    </div>
  </div>
</div>

</body>
</html>